# Claude API (author agent's brain)
ANTHROPIC_API_KEY=

# Whitechain testnet RPC endpoint (see docs.whitechain.io)
WHITECHAIN_RPC_URL=
WHITECHAIN_CHAIN_ID=2625
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io

# Author agent wallet (the buyer) — generated by wallets/setup_wallets.py
AUTHOR_WALLET_ADDRESS=
AUTHOR_WALLET_PRIVATE_KEY=

# Photobank wallet (the seller) — generated by wallets/setup_wallets.py
PHOTOBANK_WALLET_ADDRESS=
PHOTOBANK_WALLET_PRIVATE_KEY=

# Photobank server
PHOTOBANK_HOST=127.0.0.1
PHOTOBANK_PORT=8000
PHOTO_PRICE_WBT=0.02

# Spending limit enforced by the author agent, per run_demo.py task
AUTHOR_MAX_SPEND_WBT=1.0

# Where the author agent keeps its running spend counter
SPEND_LEDGER_PATH=.spend_ledger.json
