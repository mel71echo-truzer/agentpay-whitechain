# Claude API (author agent's brain)
ANTHROPIC_API_KEY=

# --- Network ---
# "local" (default) — everything runs against an in-memory EVM chain;
#   scripts/demo.py and tests/ deploy tEURC (+ MockSoulRegistry, if
#   USE_MOCK_SOUL=true) fresh every run. No RPC/keys needed below.
# "whitechain_testnet" — real Whitechain testnet. See DEPLOY_WHITECHAIN.md.
NETWORK=local
WHITECHAIN_TESTNET_RPC=
CHAIN_ID=2625
DEPLOYER_PRIVATE_KEY=
WHITECHAIN_EXPLORER_URL=https://testnet.whitechain.io

# --- WB Soul (KYA + reputation) ---
# true  -> deploy/use MockSoulRegistry locally (facilitator fully controls
#          verification + SBT issuance — this is what scripts/demo.py uses).
# false -> read REAL WB Soul contract addresses below (facilitator can only
#          read them, not verify/issue anything — that's WhiteBIT's KYC).
USE_MOCK_SOUL=true
SOUL_REGISTRY_ADDRESS=
SOUL_ATTRIBUTE_REGISTRY_ADDRESS=
SOUL_BOUND_TOKEN_REGISTRY_ADDRESS=
IS_VERIFIED_ATTRIBUTE_ADDRESS=
SBT_COLLECTION_ADDRESS=

# --- tEURC (test EURC-style stablecoin, EIP-3009) ---
# Filled in by `npx hardhat run deploy/deploy.ts --network <network>`.
TEURC_ADDRESS=

# --- Wallets ---
# Author agent (buyer) — signs EIP-3009 authorizations, never pays gas itself.
AUTHOR_WALLET_ADDRESS=
AUTHOR_WALLET_PRIVATE_KEY=
# Facilitator — relays transferWithAuthorization on-chain (pays gas in WBT),
# receives the full payment, keeps its fee, forwards the rest.
FACILITATOR_WALLET_ADDRESS=
FACILITATOR_WALLET_PRIVATE_KEY=
# AI Service Provider (seller) — receives price minus the facilitator's fee.
SERVICE_PROVIDER_WALLET_ADDRESS=
SERVICE_PROVIDER_WALLET_PRIVATE_KEY=

# --- AI Service Provider server ---
SERVICE_PROVIDER_HOST=127.0.0.1
SERVICE_PROVIDER_PORT=8000
RESOURCE_PRICE_TEURC=0.02
PREMIUM_RESOURCE_PRICE_TEURC=0.10
# Minimum reputation_tier (SBT count, 0/1/2) required for the premium resource.
PREMIUM_MIN_REPUTATION_TIER=1

# Facilitator's fee, in basis points (50 = 0.5%).
FACILITATOR_FEE_BPS=50

# --- Spending limit enforced by the author agent, per scripts/demo.py task ---
AUTHOR_MAX_SPEND_TEURC=1.0

# Where the author agent keeps its running spend counter
SPEND_LEDGER_PATH=.spend_ledger.json
